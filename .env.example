# Copy to .env for local development. .env is gitignored.
# Every value here can also be set in config/anteater.toml.

# ---- database ----
ANTEATER_GENERAL__DB_URL=postgresql+asyncpg://anteater:anteater@localhost:5432/anteater
# ANTEATER_GENERAL__DB_URL=sqlite+aiosqlite:///./anteater.db
ANTEATER_GENERAL__GRID_PRECISION=7

# ---- kismet ----
ANTEATER_KISMET__URL=ws://localhost:2501
ANTEATER_KISMET__USER=kismet
ANTEATER_KISMET__PASSWORD=changeme

# ---- logging ----
ANTEATER_LOG_LEVEL=INFO

# ---- alerts ----
ANTEATER_ALERTS__AUDIO=true
ANTEATER_ALERTS__VIDEO=false
ANTEATER_ALERTS__TTS=true
ANTEATER_ALERTS__MQTT=false

# ---- termite ----
ANTEATER_TERMITE__ITU_REGION=2
